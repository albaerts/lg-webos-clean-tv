{
    "id": "com.webos.app.home",
    "version": "2.0.0",
    "vendor": "LG Electronics",
    "type": "web",
    "main": "index.html",
    "title": "Home",
    "transparent": false,
    "splashBackground": "splash.png",
    "icon": "icon.png",
    "noSplashOnLaunch": true,
    "mediumIcon": "icon.png",
    "largeIcon": "icon.png",
    "iconColor": "#1ec15f",
    "visible": false,
    "class": { "hidden": true },
    "disableBackHistoryAPI": true,
    "lockable": false,
    "supportQuickStart": false,
    "hasPromotion": false,
    "accessibility": { "supportsAudioGuidance": true },
    "handleScreenRemoteKey": true,
    "enablePigScreenSaver": false,
    "hasAccountService": true,
    "appCategory": ["home"],
    "resolution": "1920x1080",
    "uiRevision": 2,
    "supportTouchMode": "full",
    "requiredPermissions": [
        "applications", "applications.launcher", "applications.operation", "applications.internal",
        "hlp.internal", "launcher.status", "launcher.control", "sdx.control", "settings", "system",
        "database.internal", "database", "private", "usercontextmanager.internal"
    ]
}
