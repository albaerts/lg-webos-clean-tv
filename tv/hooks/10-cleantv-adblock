#!/bin/sh
# 10-cleantv-adblock - block LG ad/telemetry/ACR hosts via /etc/hosts (bind-mounted copy; rootfs is read-only). Runs every boot.
# Reversible: remove this file + reboot.
H=/var/lib/webosbrew/cleantv/config/adblock-hosts
[ -f "$H" ] || exit 0
if ! touch /etc/hosts 2>/dev/null; then cp /etc/hosts /tmp/hosts.cleantv; mount --bind /tmp/hosts.cleantv /etc/hosts; fi
grep -q CLEANTV-ADBLOCK /etc/hosts 2>/dev/null && exit 0
printf '\n# CLEANTV-ADBLOCK\n' >> /etc/hosts
sed -e 's/#.*$//' -e '/^[[:space:]]*$/d' "$H" >> /etc/hosts
exit 0
